  id: opening
  clip: {fileID: 32900000, guid: 7e64c50de94fc4c53aa5f5ba90f8dc26, type: 3}
  completionFact: cinematic_opening_complete
  subtitle: Jamie sees the road before he knows which direction he will choose.
  subtitleCues:
  - startSeconds: 0
    text: See those lights?
  - startSeconds: 5
    text: That's a water tower.
  - startSeconds: 10
    text: Tonight, it's north.
  - startSeconds: 15
    text: What's there?
  - startSeconds: 20
    text: Whatever isn't here.
  - startSeconds: 25
    text: Do they have better fries?
  - startSeconds: 30
    text: Statistically, probably.
  - startSeconds: 35
    text: Then it's settled. We save up, fix a car, and we all go.
  - startSeconds: 40
    text: All of us?
  - startSeconds: 45
    text: All of us.
