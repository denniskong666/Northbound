  m_Name: Finale
  m_EditorClassIdentifier: Northbound.Runtime::Northbound.Cinematics.CinematicAsset
  id: finale
  clip: {fileID: 32900000, guid: dcbb2c89781e44b0a86222495371be48, type: 3}
  completionFact: cinematic_finale_complete
  subtitle: A direction becomes a life only when Jamie chooses to move.
  subtitleCues:
  - startSeconds: 0
    text: Are you coming?
  - startSeconds: 5
    text: The station wagon idles while the five friends keep separate distances.
  - startSeconds: 10
    text: The second key catches the first edge of dawn.
  - startSeconds: 15
    text: No marker points toward the road nobody named.
  - startSeconds: 20
    text: Maya waits near the arts center with paint on her sleeve.
  - startSeconds: 25
    text: Noah stands between the shop and the radio station, listening to both.
  - startSeconds: 30
    text: Leo leans against the dark diner door with the sign turned blank.
  - startSeconds: 35
    text: Elias asks once and lets the engine fill the space afterward.
