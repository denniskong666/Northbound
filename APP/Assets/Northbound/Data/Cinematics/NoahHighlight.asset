  m_Script: {fileID: 11500000, guid: 25c1c2f673c994a38ad2eea31aa4c4d4, type: 3}
  m_Name: NoahHighlight
  m_EditorClassIdentifier: Northbound.Runtime::Northbound.Cinematics.CinematicAsset
  id: noah
  clip: {fileID: 32900000, guid: 6bdabb3697aca47a7bd0b5ee44a40605, type: 3}
  completionFact: cinematic_noah_complete
  subtitle: Noah leaves room in the silence for Jamie to answer himself.
  subtitleCues:
  - startSeconds: 0
    text: The radio tower is not north. It is only up the hill.
  - startSeconds: 5
    text: For today, that is far enough.
  - startSeconds: 10
    text: Noah puts on the headphones before he enters the booth.
  - startSeconds: 15
    text: The first thing on the tape is rain on the diner awning.
  - startSeconds: 20
    text: He speaks his own name into the microphone and does not apologize.
  - startSeconds: 25
    text: His father hears the signal through the shop radio but does not interrupt
      it.
  - startSeconds: 30
    text: Noah lowers the volume until the station sounds like a room, not an escape
      hatch.
  - startSeconds: 35
    text: Jamie hears the garage wrench click between the train and the wind.
  - startSeconds: 40
    text: The recording ends with Noah breathing into the microphone on purpose.
  cinematicAudioSnapshot: {fileID: 24500016, guid: 9cdaa59156dd2423bafb7fedf86c5521, type: 2}
  gameplayAudioSnapshot: {fileID: 24500006, guid: 9cdaa59156dd2423bafb7fedf86c5521, type: 2}
