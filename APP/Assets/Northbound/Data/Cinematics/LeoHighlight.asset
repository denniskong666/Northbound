  m_Script: {fileID: 11500000, guid: 25c1c2f673c994a38ad2eea31aa4c4d4, type: 3}
  m_Name: LeoHighlight
  m_EditorClassIdentifier: Northbound.Runtime::Northbound.Cinematics.CinematicAsset
  id: leo
  clip: {fileID: 32900000, guid: b20da990f02724b25ae683e441434150, type: 3}
  completionFact: cinematic_leo_complete
  subtitle: Leo makes the ordinary work feel like a place worth returning to.
  subtitleCues:
  - startSeconds: 0
    text: Last customer. Last fries. Last bell. I don't know what comes after last.
  - startSeconds: 5
    text: Maybe tomorrow gets a turn.
  - startSeconds: 10
    text: Leo keeps one diner light on after the chairs are stacked.
  - startSeconds: 15
    text: He rubs the CLOSED sign clean with his sleeve.
  - startSeconds: 20
    text: The blank reverse side makes him laugh without hiding the sadness.
  - startSeconds: 25
    text: Ruth leaves him the keys long enough to lock the door himself.
  - startSeconds: 30
    text: Leo sets one mug aside for his grandmother and does not make a joke about
      it.
  - startSeconds: 35
    text: The fryer goes quiet, making the room feel larger.
  - startSeconds: 40
    text: He turns the sign over slowly, as if the word needs time to land.
  cinematicAudioSnapshot: {fileID: 24500016, guid: 9cdaa59156dd2423bafb7fedf86c5521, type: 2}
  gameplayAudioSnapshot: {fileID: 24500006, guid: 9cdaa59156dd2423bafb7fedf86c5521, type: 2}
