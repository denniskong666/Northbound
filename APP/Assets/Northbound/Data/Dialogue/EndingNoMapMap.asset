  m_Script: {fileID: 11500000, guid: ed70aee8cc8cd4f8ca7ec0b6c7dc5db3, type: 3}
  m_Name: EndingNoMapMap
  m_EditorClassIdentifier: Northbound.Runtime::Northbound.Dialogue.DialogueAsset
  id: ending_no_map_map
  lines:
  - speakerId: Jamie
    text: Jamie folds the old map and keeps it. The road does not require it to be
      destroyed.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: The folded map stays in Jamie's pocket, neither obeyed nor discarded.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: Its creases keep the rooftop signatures together.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: The unmarked road bends before any city lights appear.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: Jamie walks until the chalk arrow is out of sight.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
