  m_Name: MissedRoadTest
  m_EditorClassIdentifier: Northbound.Runtime::Northbound.Dialogue.DialogueAsset
  id: missed_road_test
  lines:
  - speakerId: Elias
    text: The wagon has fresh mud on one tire and no new stories in it.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Elias
    text: It ran. I guess that was supposed to settle something.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Elias
    text: Fresh mud stops at the garage threshold.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Elias
    text: The passenger seat belt is twisted from someone riding alone.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Elias
    text: A cooling engine gives the service road no explanation.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
