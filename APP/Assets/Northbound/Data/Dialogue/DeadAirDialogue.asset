  m_Script: {fileID: 11500000, guid: ed70aee8cc8cd4f8ca7ec0b6c7dc5db3, type: 3}
  m_Name: DeadAirDialogue
  m_EditorClassIdentifier: Northbound.Runtime::Northbound.Dialogue.DialogueAsset
  id: dead_air_dialogue
  lines:
  - speakerId: Jamie
    text: Why record things you want to leave?
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Noah
    text: Because leaving and forgetting aren't the same.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Noah
    text: 'Listen: train, bell, wrenches, wind. It sounds small when you put it together.'
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: Noah labels each sound in careful block letters.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: The recorder catches the diner bell through an open window.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: He rewinds to the rooftop wind and lets it play too long.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: Jamie notices the radio application under a coil of wire.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Jamie
    text: Noah turns the page face down, but not away.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
