  m_Name: MissedLastNightOpen
  m_EditorClassIdentifier: Northbound.Runtime::Northbound.Dialogue.DialogueAsset
  id: missed_last_night_open
  lines:
  - speakerId: Leo
    text: The diner is dark before closing time. A chair waits upside down on the
      old table.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Leo
    text: Nobody likes a quiet goodbye.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Leo
    text: The chalkboard menu still lists soup that will not be served.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Leo
    text: Ruth's keys are gone from their hook behind the counter.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
    choices: []
  - speakerId: Leo
    text: Leo's joke is written on a napkin and never delivered.
    portrait: {fileID: 0}
    reactionClip: {fileID: 0}
    requiredFact: 
    grantedFact: 
    nextLineIndex: -1
